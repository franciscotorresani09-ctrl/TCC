# ── Database ─────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/streetcar"

# ── Auth.js ──────────────────────────────────────────────
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Optional OAuth providers (buttons are disabled until configured)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_APPLE_ID=""
AUTH_APPLE_SECRET=""

# ── Public site URL (SEO, sitemap, Open Graph) ───────────
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Image storage ────────────────────────────────────────
# "local" writes to /public/uploads (development only).
# "cloudinary" uploads to Cloudinary using a signed request.
STORAGE_DRIVER="local"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
